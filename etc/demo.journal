; account: Expenses:Housing:Rent  € 1200.00
; account: Assets:Checking  € -1200.00
; template-end
; template-start: Monthly Salary
; id: salary
; payee: Employer
; note: Monthly Salary
; account: Assets:Checking  € 2500.00
; account: Income:Salary  € -2500.00
; template-end
; template-start: Freelance
; id: freelance
; payee: Client
; note: Freelance Payment
; account: Assets:Checking  € 600.00
; account: Income:Freelance  € -600.00
; template-end
; template-start: Credit Card Payment
; id: cc-payment
; payee: Credit Card Payment
; account: Liabilities:Credit Card  € 200.00
; account: Assets:Checking  € -200.00
; template-end
; template-start: Cash Withdrawal
; id: atm
; payee: ATM
; note: Cash Withdrawal
; account: Assets:Cash  € 50.00
; account: Assets:Checking  € -50.00
; template-end

