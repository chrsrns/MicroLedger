; MicroLedger demo journal
; Designed to populate the Dashboard with net worth, account balances,
; and cash-flow data.
; template-start: Grocery
; id: grocery
; payee: Supermarket
; note: Groceries
; account: Expenses:Food  € 45.00
; account: Assets:Checking  € -45.00
; template-end
; template-start: Rent
; id: rent
; payee: Landlord
